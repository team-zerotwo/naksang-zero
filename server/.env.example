# 서버 포트. 컨테이너에서는 8080을 권장합니다.
PORT=3000

# SQLite 파일. 디렉터리가 없으면 서버가 만듭니다. 테스트는 메모리 DB를 씁니다.
DATABASE_PATH=./data/naksang.db

# `npm run generate-vapid` 출력값을 붙여 넣습니다. 실제 키는 커밋하지 마세요.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:demo@naksang.local

# true 일 때만 POST /api/dev/trigger-reconfirm, POST /api/dev/reset
ENABLE_DEV_ENDPOINTS=false

# 보호자 웹 빌드 결과. 없으면 API만 띄웁니다.
STATIC_DIR=../guardian-web/dist
